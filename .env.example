# Scolar environment. Copy to .env.local for local dev, and add the same keys in Vercel > Settings > Environment
# Variables for production. docs/SETUP.md says where each value comes from.

# Site (Stage 1)
NEXT_PUBLIC_SITE_URL=http://localhost:3010
# Fallback name, used only until the brand is saved in Admin > Settings > Branding.
NEXT_PUBLIC_SITE_NAME=Scolar

# Supabase (Stage 2). Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Personal access token (supabase.com/dashboard/account/tokens). Lets Admin > Emails push sign-in email designs.
SUPABASE_ACCESS_TOKEN=

# Cloudflare R2 file storage (Stage 3). All uploads (images, videos, documents, logos) live here.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
NEXT_PUBLIC_R2_PUBLIC_URL=https://files.yourschool.com

# Email via Resend (Stage 4). The from address must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=support@yourschool.com
# Optional: where replies to emails go.
EMAIL_REPLY_TO=
# Optional: where contact form messages go when no support email is set in Admin > Settings > Platform.
CONTACT_INBOX=
# Optional: public base URL for email images (public/email/*). Defaults to NEXT_PUBLIC_SITE_URL.
EMAIL_ASSET_URL=

# Paystack (Stage 5)
PAYSTACK_SECRET_KEY=

# Scheduled jobs (Stage 6). Any long random string; also stored in the Supabase Vault as cron_secret.
CRON_SECRET=

# Optional AI features (Stage 8). Cloudflare Workers AI. Leave empty to hide AI features.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# Optional: lets the AI course writer read web pages you point it at.
FIRECRAWL_API_KEY=
